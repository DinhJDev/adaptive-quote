# Set these as process or deployment variables when overriding local defaults.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/adaptive_quote
SPRING_DATASOURCE_USERNAME=quote
SPRING_DATASOURCE_PASSWORD=adaptive_quote_local
QUOTE_PUBLIC_ORIGIN=http://localhost:8080
# Set a unique value of at least 32 bytes to keep sessions valid across restarts.
QUOTE_SESSION_SECRET=

# Optional server-side OpenAI extraction. The demo catalog works with no key.
QUOTE_AI_ENABLED=false
OPENAI_API_KEY=

# Optional first check for exact U.S. matches via NHTSA vPIC.
QUOTE_VPIC_ENABLED=true

# Hosted environments use a separate migration role.
# SPRING_FLYWAY_URL=jdbc:postgresql://DB_HOST:5432/adaptive_quote
# SPRING_FLYWAY_USER=quote_migrations
# SPRING_FLYWAY_PASSWORD=
